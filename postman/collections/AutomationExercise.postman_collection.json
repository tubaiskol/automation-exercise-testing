              "path": ["api", "productsList"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Unsupported method is reported', function () {",
                  "  pm.expect(body.responseCode).to.eql(405);",
