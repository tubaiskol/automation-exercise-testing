    {
      "name": "Authentication",
      "item": [
        {
          "name": "API-007 | Verify Login with Valid Details",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{testUserEmail}}", "type": "text" },
                { "key": "password", "value": "{{testUserPassword}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const credentialsConfigured = Boolean(pm.environment.get('testUserEmail') && pm.environment.get('testUserPassword'));",
                  "if (credentialsConfigured) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Existing user is confirmed', function () {",
                  "    pm.expect(body.responseCode).to.eql(200);",
                  "    pm.expect(body.message).to.eql('User exists!');",
                  "  });",
                  "} else {",
                  "  pm.test.skip('Configure testUserEmail and testUserPassword to run API-007');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "API-008 | Verify Login Without Email",
          "request": {
            "method": "POST",
            "header": [],
