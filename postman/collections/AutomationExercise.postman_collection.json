      "name": "Products",
      "item": [
        {
          "name": "API-001 | Get All Products List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productsList"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Application response code is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('Products are returned', () => pm.expect(body.products).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "API-002 | POST to All Products List",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
